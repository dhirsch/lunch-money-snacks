{
  "manifest_version": 3,
  "name": "Lunch Money Budget Enhancer",
  "version": "0.1.0",
  "description": "Add detailed notes and itemized breakdowns to your Lunch Money budget categories",
  "permissions": ["storage"],
  "host_permissions": [
    "https://my.lunchmoney.app/*",
    "https://api.lunchmoney.dev/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://my.lunchmoney.app/budget*"],
      "js": ["src/content/index.tsx"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Lunch Money Budget Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
