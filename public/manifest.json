{
  "manifest_version": 3,
  "name": "Lunch Money Budget Enhancer",
  "version": "0.1.0",
  "description": "Add detailed notes and itemized breakdowns to your Lunch Money budget categories",
  "permissions": ["storage"],
  "host_permissions": ["https://my.lunchmoney.app/*"],
  "content_scripts": [
    {
      "matches": ["https://my.lunchmoney.app/budget*"],
      "js": ["src/content/index.tsx"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Lunch Money Budget Enhancer",
    "default_popup": "settings.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
